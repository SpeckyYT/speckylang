{
  "name": "SpeckyLang",
  "scopeName": "source.specky",
  "fileTypes": ["specky"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#operators" },
    { "include": "#delimiters" },
    { "include": "#symbols" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.specky",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.slash.specky",
          "begin": "/",
          "end": "/",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.string.begin.specky" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.string.end.specky" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.specky",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.specky",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "constant.language.specky",
          "match": "\\b(?:null|true|false)\\b"
        },
        {
          "name": "constant.language.time.specky",
          "match": "[µμ]"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.specky",
          "match": "\\|<|<=>|<=|=>"
        },
        {
          "name": "keyword.operator.comparison.specky",
          "match": ">-<|><|=<|>=|=|<|>"
        },
        {
          "name": "keyword.operator.arithmetic.specky",
          "match": "%%|[+*%^-]"
        },
        {
          "name": "keyword.operator.logical.specky",
          "match": "&|\\||\\?|!|\\$|°"
        },
        {
          "name": "keyword.operator.access.specky",
          "match": "§|'|@|~|\\\\"
        }
      ]
    },
    "delimiters": {
      "patterns": [
        {
          "name": "punctuation.section.braces.specky",
          "match": "[{}]"
        },
        {
          "name": "punctuation.section.brackets.specky",
          "match": "[\\[\\]]"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "variable.other.specky",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
