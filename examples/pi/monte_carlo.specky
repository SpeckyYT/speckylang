|< print_every_n <= 10000

|< start <= µ

|< in_circle <= 0
|< in_square <= 0

|< rng_seed <= 0
|< rng_bit_size <= 4294967296.0 \ 2.0

[<] rng_func
    |< rng_return + 1

    |< new_rng <= §start {%\<} - //
    |< rng_seed + §new_rng % 4294967296
        * 1664525 + 1013904223 % 4294967296
    |< rng_iter - 1
[>] rng_return

[<] loop
    [<] rng_return [>] rng_func |< x <= §rng_seed \ §rng_bit_size - 1.0
    [<] rng_return [>] rng_func |< y <= §rng_seed \ §rng_bit_size - 1.0
    
    # |< x {@\°} {%}
    # |< y {@\°} {%}
    
    |< xs <= §x * §x
    |< ys <= §y * §y
    |< hy <= §xs + §ys ^ 0.5 < 1.0 ??
        |< in_circle + 1
    |< in_square + 1

    # |< in_square {@\°} {%}
    # |< in_circle {@\°} {%}

    |< skip <= §in_square % §print_every_n ? [>] skip_drawing

    |< pi <= 4.0 * §in_circle \ §in_square {%\°}
    |< /(/ {@$\}
    |< in_circle {%\}
    |< /|/ {@$\}
    |< in_square {%\}
    |< /)/ {@$}

    [<] skip_drawing
[>] loop
